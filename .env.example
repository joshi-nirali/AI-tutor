# Speccon AI Tutor — backend environment template
# ────────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` (same folder) and fill in real values:
#     cp .env.example .env
#
# The agent worker (agent.py), the token server, and any helper scripts all read
# from this single .env at the project root. The React frontend has its OWN env
# file at frontend/.env.example → copy to frontend/.env.local for the browser.
#
# Keys without `#` in front are REQUIRED unless commented otherwise.
# ────────────────────────────────────────────────────────────────────────────────


# ════════════════════════════════════════════════════════════════════════════════
# 1) bitHuman — talking avatar video (optional)
# ════════════════════════════════════════════════════════════════════════════════
# Sign up: https://www.bithuman.ai → create one agent per tutor character (Leo, Cub, …)
# Skip this entire block (or set KID_TUTOR_USE_AVATAR=0) if you want voice-only.

BITHUMAN_API_SECRET=your-bithuman-api-secret

# One BitHuman Agent ID per tutor slug. Slug is whatever appears in the room name
# `kidtutor-{mode}-{topic}-{slug}-…` (see frontend/src/App.js AVATARS list).
# Add more if you add more tutors (BITHUMAN_AGENT_ID_LUNA, …).
BITHUMAN_AGENT_ID_LEO=A02QCM0553
BITHUMAN_AGENT_ID_CUB=A67RKX0594

# Fallback used when a room slug has no BITHUMAN_AGENT_ID_<SLUG> override.
BITHUMAN_AGENT_ID=A02QCM0553

# 1 = use the BitHuman video avatar (requires the keys above).
# 0 = voice-only, no BitHuman keys needed.
KID_TUTOR_USE_AVATAR=1

# Avatar expressiveness model:
#   "essence"    = predefined actions + deterministic lip-sync (sharp mouth motion,
#                  face mostly still). Better for tight lip-sync.
#   "expression" = dynamic facial expressions (eyebrows, eyes, head motion) but
#                  mouth tracking is softer / less precise. Better for whole-face energy.
# Per-tutor override: BITHUMAN_MODEL_LEO=essence, BITHUMAN_MODEL_CUB=expression, …
BITHUMAN_MODEL=essence

# A/V sync delay (ms) — hold room audio so it aligns with BitHuman's video frames.
# Tune by ear; per-tutor override available (LEO/CUB/…).
# Typical landing zones:
#   essence    over good wifi  →  50–150 ms
#   expression over good wifi  →  300–450 ms
AVATAR_AUDIO_DELAY_MS=350
# AVATAR_AUDIO_DELAY_MS_LEO=400
# AVATAR_AUDIO_DELAY_MS_CUB=350

# Optional: 1 enables LiveKit's noise filter on the agent input; 0 (default) lets STT see raw audio.
KID_TUTOR_AGENT_NOISE_FILTER=0


# ════════════════════════════════════════════════════════════════════════════════
# 2) Cartesia — REQUIRED (Sonic TTS for tutor voice + Ink STT fallback)
# ════════════════════════════════════════════════════════════════════════════════
# Get the API key: https://play.cartesia.ai → API keys
CARTESIA_API_KEY=sk_car_xxxxxxxxxxxxxxxxxxxxxxxx

# Ink STT (transcribes child speech). Default model is fine for most languages.
CARTESIA_STT_MODEL=ink-whisper
CARTESIA_STT_LANGUAGE=en

# Sonic TTS model. Sonic-3 sounds the most natural; older options: sonic-2, sonic, sonic-turbo, sonic-lite.
CARTESIA_TTS_MODEL=sonic-3

# Sonic-3 speech speed: 0.6 (slow) … 1.0 (normal) … 2.0 (fast).
# Leo and Cub default to 0.88 in agent.py if these are unset (slower for ages 3–7).
CARTESIA_TTS_SPEED_LEO=0.85
CARTESIA_TTS_SPEED_CUB=0.85

# Voice UUIDs for each tutor — copy from play.cartesia.ai for the voices you cloned/picked.
# CARTESIA_VOICE is the global fallback used when no per-tutor override matches.
CARTESIA_VOICE=baf84392-fa95-4d44-8871-d32ee36b0e01
CARTESIA_VOICE_LEO=baf84392-fa95-4d44-8871-d32ee36b0e01
CARTESIA_VOICE_CUB=072d954b-8379-4b6b-816a-bb0cd38725f8


# ════════════════════════════════════════════════════════════════════════════════
# 3) Deepgram — STT (preferred for child speech; nova-3 handles noisy audio well)
# ════════════════════════════════════════════════════════════════════════════════
# Get the API key: https://console.deepgram.com → Create API Key
DEEPGRAM_API_KEY=your-deepgram-api-key

# Model: nova-3 (recommended for kids/noisy audio), nova-2, or base.
DEEPGRAM_STT_MODEL=nova-3

# STT language. Use "en-IN" (Indian English) for Indian-accented children; both nova-3 and
# nova-2 support it well. Other choices: en, en-US, en-GB, en-AU, multi (nova-3 multilingual).
DEEPGRAM_STT_LANGUAGE=en-IN

# Optional extra words to boost in STT (comma- or pipe-separated). The current lesson word
# list is ALWAYS added automatically — these are extras (your child's name, common animals, etc.).
# DEEPGRAM_KEYTERMS=elephant,banana,apple,Rachel

# Endpoint silence threshold in ms before Deepgram finalizes a turn (default 25).
# Kids often pause mid-word; raising to 250–500 cuts off fewer real attempts.
# DEEPGRAM_ENDPOINTING_MS=300

# Smart format (auto numbers/dates/currency). Default 0 — keeps the literal spoken word so
# pronunciation matching ("cat") doesn't get rewritten ("CAT 3" etc.).
# DEEPGRAM_SMART_FORMAT=0

# Keep filler words like "uh", "um" in transcripts. Default 1; turn off to silence them.
# DEEPGRAM_FILLER_WORDS=1


# ════════════════════════════════════════════════════════════════════════════════
# 4) OpenAI — REQUIRED (LLM for tutor reasoning, not used for STT or TTS)
# ════════════════════════════════════════════════════════════════════════════════
# Get the API key: https://platform.openai.com → API keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Any chat-capable model (gpt-4.1-mini is a good price/latency balance).
OPENAI_LLM_MODEL=gpt-4.1-mini


# ════════════════════════════════════════════════════════════════════════════════
# 5) LiveKit Cloud — REQUIRED (real-time room transport)
# ════════════════════════════════════════════════════════════════════════════════
# Dashboard: https://cloud.livekit.io → your project → Settings
#   • WebSocket URL → LIVEKIT_URL (must begin with wss://)
#   • API Keys → create a key; copy its Key and Secret below
# The agent worker, token server, AND the browser must all use the SAME project.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxx
LIVEKIT_API_SECRET=your-livekit-api-secret

# `relay` forces TURN; safer behind strict NATs and corporate networks.
# Use `direct` only on permissive networks for slightly lower latency.
LIVEKIT_AGENT_ICE_TRANSPORT=relay

# Must match the agent registration in agent.py (do not change unless you know why).
LIVEKIT_AGENT_NAME=kid-tutor


# ════════════════════════════════════════════════════════════════════════════════
# 6) Token server (Flask app issuing LiveKit room tokens to the browser)
# ════════════════════════════════════════════════════════════════════════════════
# Default 5000; macOS reserves 5000 for AirPlay, so we use 5001 here.
TOKEN_SERVER_PORT=5001

# Optional: public URL of the token server so /curriculum image URLs work when
# the React app is served from a different host/port.
# TOKEN_SERVER_PUBLIC_URL=https://your-token-host.example.com


# ════════════════════════════════════════════════════════════════════════════════
# 7) Curriculum / prompt overrides (optional)
# ════════════════════════════════════════════════════════════════════════════════
# Override the fixed word lists JSON (default: data/word_lists.json).
# KID_CURRICULUM_PATH=/path/to/custom_word_lists.json

# Override the prompts folder (default: data/prompts/).
# Folder must contain ai_prompts.json, response_templates.json, pronunciation_rules.json.
# KID_PROMPTS_DIR=/path/to/prompts


# ════════════════════════════════════════════════════════════════════════════════
# 8) Lesson behaviour tuning (all optional — uncomment to override defaults)
# ════════════════════════════════════════════════════════════════════════════════

# Speaking-mode pronunciation gate (default 55). Vocabulary uses KID_TUTOR_MIN_ATTEMPT_SCORE (40).
# KID_TUTOR_SPEAKING_MIN_ATTEMPT_SCORE=55
# KID_TUTOR_MIN_ATTEMPT_SCORE=40

# Log every recognized STT final transcript at INFO so you can see what was heard. Default 1.
KID_TUTOR_LOG_TRANSCRIPTS=1
# Stream Deepgram interim (partial) transcripts as `stt_chunk raw:` lines, mirroring the
# TTS chunk logs. Default 1 = on. Set 0 to keep only the final summary line per utterance.
KID_TUTOR_LOG_INTERIM_TRANSCRIPTS=1

# Set to 0 to disable scripted post-score replies entirely.
# KID_TUTOR_SCORING_REPLY=0

# Max seconds to wait for session.interrupt() during the scripted-reply flow.
# Default 2.0; clamped 0.15–8. Bump on `relay` ICE if you see "speech not done in time".
KID_TUTOR_INTERRUPT_TIMEOUT=3.5

# RPC timeout for BitHuman clear-buffer (must be < INTERRUPTION_TIMEOUT, default 15s).
KID_TUTOR_AVATAR_CLEAR_BUFFER_RPC_TIMEOUT_S=8

# After a "correct" pronunciation, auto-advance the lesson picture by one step. Default 1.
KID_TUTOR_AUTO_ADVANCE_ON_CORRECT=1

# 1 = picture only jumps to next word AFTER the child speaks again (prevents silent advances).
# 0 = picture advances immediately on each correct score.
KID_TUTOR_DEFER_PICTURE_UNTIL_RESPONSE=0

# Seconds to suppress pronunciation scoring right after intro / auto-advance celebration
# (prevents bogus STT finals from skipping ahead while the child is silent).
KID_TUTOR_POST_INTRO_SCORING_DELAY_S=5.0
KID_TUTOR_POST_ADVANCE_SCORING_DELAY_S=3.5

# Grace period (ms, clamped 2000–30000) for the goodbye to play before the browser
# redirects back to the categories grid after the last word.
KID_TUTOR_LESSON_COMPLETE_DELAY_MS=20000


# ════════════════════════════════════════════════════════════════════════════════
# 9) Misc (rarely needed)
# ════════════════════════════════════════════════════════════════════════════════
# Fallback tutor display name when the room name has no tutor slug (normally unused).
# TUTOR_NAME=Leo

# NODE_IP=203.0.113.1
