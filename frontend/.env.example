# Copy to .env.local for Create React App

# Cartesia voices — must match root .env CARTESIA_VOICE_LEO / CARTESIA_VOICE_CUB (restart npm after edits)
REACT_APP_CARTESIA_VOICE_LEO=baf84392-fa95-4d44-8871-d32ee36b0e01
REACT_APP_CARTESIA_VOICE_CUB=072d954b-8379-4b6b-816a-bb0cd38725f8

# Port 5000 is taken by macOS AirPlay Receiver — token server runs on 5001
REACT_APP_TOKEN_SERVER_URL=http://127.0.0.1:5001/token