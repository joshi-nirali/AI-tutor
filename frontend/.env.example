# Copy to .env.local for Create React App
# Token API (must match token_server.py, default port 5000)
REACT_APP_TOKEN_SERVER_URL=http://127.0.0.1:5000/token

# Optional: if you do not return "url" from /token, set the LiveKit WebSocket URL here
# REACT_APP_LIVEKIT_URL=wss://your-project.livekit.cloud

# Cartesia Sonic voice UUIDs — must match essence-cloud/.env CARTESIA_VOICE_LEO / CARTESIA_VOICE_CUB
# Copy the same UUIDs from play.cartesia.ai into both files, then restart npm and agent.py
# REACT_APP_CARTESIA_VOICE_LEO=your-leo-voice-uuid
# REACT_APP_CARTESIA_VOICE_CUB=your-cub-voice-uuid
